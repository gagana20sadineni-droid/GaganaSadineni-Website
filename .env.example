# Copy to .env.local for local development, and add the same values in
# Vercel -> Project -> Settings -> Environment Variables for production.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=me@gaganasadineni.com

# The "From" address. Must be on a domain you have verified in Resend.
# Until you verify gaganasadineni.com, you can use Resend's test sender:
#   onboarding@resend.dev
CONTACT_FROM_EMAIL="Gagana Sadineni Website <contact@gaganasadineni.com>"

# Canonical site URL, used for metadata, sitemap, and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://gaganasadineni.com
